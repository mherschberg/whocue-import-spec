{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mherschberg/whocue-import-spec/schema/whocue-event-prep-prompt-catalog-v1.schema.json",
  "title": "WhoCue Event Prep Prompt Catalog v1",
  "description": "Version 1.0 schema for the fixed Event Prep prompt and app-provided Brief Templates that WhoCue bundles for offline use.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "general_prompt",
    "brief_templates"
  ],
  "properties": {
    "format": {
      "type": "string",
      "const": "whocue_event_prep_prompt_catalog"
    },
    "format_version": {
      "type": "string",
      "const": "1.0"
    },
    "general_prompt": {
      "$ref": "#/$defs/general_prompt"
    },
    "brief_templates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/brief_template"
      }
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "pattern": "^whocue\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "semantic_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "general_prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "instruction_set",
        "brief_placeholder",
        "prompt_template"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stable_id"
        },
        "version": {
          "$ref": "#/$defs/semantic_version"
        },
        "instruction_set": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "url"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/stable_id"
            },
            "version": {
              "$ref": "#/$defs/semantic_version"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048,
              "pattern": "^https://github\\.com/mherschberg/whocue-import-spec/blob/main/instructions/event-prep-v[0-9]+\\.[0-9]+\\.[0-9]+\\.md$"
            }
          }
        },
        "brief_placeholder": {
          "type": "string",
          "const": "{{brief_context}}"
        },
        "prompt_template": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "pattern": "\\{\\{brief_context\\}\\}"
        }
      }
    },
    "brief_template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "title",
        "context"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stable_id"
        },
        "version": {
          "$ref": "#/$defs/semantic_version"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        },
        "context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500,
          "pattern": "\\S"
        }
      }
    }
  }
}
